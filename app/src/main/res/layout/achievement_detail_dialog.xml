<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/iconText"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_profile_tile"
        android:gravity="center"
        android:textColor="@color/trail_blue"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/titleText"
        style="@style/TrailText.Section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/gradeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_profile_small_button"
        android:textColor="@color/trail_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/unlockedAtText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/trail_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="end"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_profile_small_button"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="&#45803;&#44592;"
        android:textColor="@color/trail_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
