<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerMenu"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="36dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/drawerTitleText"
        style="@style/TrailText.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TrailNote"
        android:textSize="20sp" />

    <TextView
        style="@style/TrailText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="설정"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/todayGoalCountMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="오늘 목표 수 설정" />

    <TextView
        android:id="@+id/themeMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="테마 변경" />

    <TextView
        android:id="@+id/notificationMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="알림" />

    <TextView
        android:id="@+id/dataMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="데이터" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="@color/trail_line" />

    <TextView
        android:id="@+id/helpMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="도움말" />

    <TextView
        android:id="@+id/aboutMenu"
        style="@style/TrailText.Body"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:text="정보" />
</LinearLayout>
